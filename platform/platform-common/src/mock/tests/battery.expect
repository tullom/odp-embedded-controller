// Mock battery service self-tests, one row per BatteryService trait method.
//
// Included by `mock/test_runner.rs` via `include!` and so must be a single
// expression (a block). Expects the following names in scope:
//   - `runner: &mut TestRunner`
//   - `battery: &impl battery_service_interface::BatteryService`
//   - `BAT` / `UNKNOWN_BAT`: `DeviceId` constants
//
// Row syntax (see `crate::test`):
//   <method>(<args>)                              => ( <verb> <vargs> );
//   <method>(<args>) -> <field>                   => ( <verb> <vargs> );
//   <method>(<args>) -> |<v>| <projection-expr>   => ( <verb> <vargs> );

{
    battery_tests!(runner, battery; {
        // ---- query methods (DeviceId only, return Result) -------------------
        battery_info(BAT)                                => ( is_ok );
        battery_info(BAT) -> design_voltage              => ( ok_eq 12_000u32 );
        battery_info(BAT) -> cycle_count                 => ( ok_eq 10_000u32 );

        battery_status(BAT)                              => ( is_ok );
        battery_status(BAT) -> battery_present_voltage   => ( ok_in 11_000u32..=13_500 );
        battery_status(BAT) -> |b| b.battery_present_rate
                                                         => ( ok_pred |r| *r <= 5_000 );

        battery_power_state(BAT)                         => ( is_ok );
        battery_power_characteristics(BAT)               => ( is_ok );
        battery_maintenance_data(BAT)                    => ( is_ok );
        is_in_use(BAT)                                   => ( is_ok );
        power_source_information(BAT)                    => ( is_ok );
        device_status(BAT)                               => ( is_ok );

        // ---- error path: unknown battery id ---------------------------------
        battery_info(UNKNOWN_BAT)                        => ( is_err );
        battery_status(UNKNOWN_BAT)                      => ( is_err );
        device_status(UNKNOWN_BAT)                       => ( is_err );
    });
}
