// Mock thermal service self-tests, one row per SensorService / FanService
// trait method.
//
// Included by `mock/test_runner.rs` via `include!` and so must be a single
// expression (a block). Expects the following names in scope:
//   - `runner: &mut TestRunner`
//   - `sensor: &impl thermal_service_interface::sensor::SensorService`
//   - `fan: &impl thermal_service_interface::fan::FanService`
//   - `TARGET: u16` — the fan rpm round-trip target

{
    use thermal_service_interface::fan::OnState;
    use thermal_service_interface::sensor::Threshold;

    // ---- SensorService ----------------------------------------------------
    sensor_tests!(runner, sensor; {
        temperature()                                    => ( pred |t| (0.0f32..=125.0).contains(t) );
        temperature_average()                            => ( pred |t| (0.0f32..=125.0).contains(t) );
        temperature_immediate()                          => ( is_ok );
        temperature_immediate()                          => ( ok_in 20.0f32..=40.0 );
        set_threshold(Threshold::Critical, 95.0)         => ( eq () );
        threshold(Threshold::Critical)                   => ( eq 95.0f32 );
        set_sample_period(embassy_time::Duration::from_millis(500))
                                                         => ( eq () );
        enable_sampling()                                => ( eq () );
        disable_sampling()                               => ( eq () );
    });

    // ---- FanService -------------------------------------------------------
    fan_tests!(runner, fan; {
        enable_auto_control()                            => ( is_ok );
        min_rpm()                                        => ( eq 0u16 );
        max_rpm()                                        => ( eq 6000u16 );
        rpm()                                            => ( pred |r| *r <= 6_000 );
        rpm_average()                                    => ( pred |r| *r <= 6_000 );
        rpm_immediate()                                  => ( is_ok );

        set_rpm(TARGET)                                  => ( is_ok );
        set_duty_percent(50)                             => ( is_ok );
        set_rpm_sampling_period(embassy_time::Duration::from_millis(250))
                                                         => ( eq () );
        set_rpm_update_period(embassy_time::Duration::from_millis(250))
                                                         => ( eq () );

        state_temp(OnState::Min)                         => ( pred |t| (0.0f32..=125.0).contains(t) );
        state_temp(OnState::Ramping)                     => ( pred |t| (0.0f32..=125.0).contains(t) );
        state_temp(OnState::Max)                         => ( pred |t| (0.0f32..=125.0).contains(t) );
        set_state_temp(OnState::Max, 80.0)               => ( eq () );
    });

    // Round-trip check: after setting TARGET above, give the fan a moment to
    // converge then verify the reported rpm.
    embassy_time::Timer::after(embassy_time::Duration::from_millis(50)).await;
    fan_tests!(runner, fan; {
        rpm_immediate()
            => ( ok_pred |rpm| (TARGET.saturating_sub(500)..=TARGET.saturating_add(500)).contains(rpm) );
        stop()                                           => ( is_ok );
    });
}
